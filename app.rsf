BasicInfo:
    Title            : "RNG Infinity"
    ProductCode      : "CTR-P-RNGI"
    Logo             : Nintendo

RomFs:
    RootPath         : "romfs"

AccessControlInfo:
    CoreVersion      : 2
    SystemMode       : 64MB
    IdealProcessor   : 0
    AffinityMask     : 1
    Priority         : 30
    HandleTableSize  : 0x200

    SystemCallAccess:
        default: true

    ServiceAccessControl:
        - apt:u
        - cfg:u
        - fs:USER
        - gsp::GPU
        - hid:USER
        - ndsp:u
        - ptm:u
        - ps:m

SystemControlInfo:
    StackSize        : 0x40000
    